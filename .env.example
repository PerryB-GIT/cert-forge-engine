# Copy to .env.local and fill in. Never commit real values.

# --- App (browser + server). Public by design: the publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# --- scripts/seed-questions.js: shared secret checked by the cf_seed_questions RPC (set your own).
CF_SEED_SECRET=

# --- scripts/cf-db.js and the verify-*.js harnesses built on it (Supabase Management API).
CF_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

# --- Direct Postgres scripts (seed-holdout, seed-tasks, verify-identity, verify-sim-draw, verify-study-lab).
CF_DB_URL=your-postgres-connection-string
CF_DB_CA=path/to/supabase-ca.crt
